# Telegram giveaway and broadcast bot (Rust). Copy to .env or /etc/<service>/bot.env.

# --- Telegram ----------------------------------------------------------------
BOT_TOKEN=123456:your_bot_token_here
# Comma-separated Telegram user IDs that may use the admin panel.
ADMIN_IDS=123456789,987654321
# Channel users must be subscribed to (numeric -100... id). The bot must be its admin.
CHANNEL_ID=-1001234567890
# Link the "Участвовать" button points to (your bot's start link).
JOIN_URL=https://t.me/your_bot?start=join

# --- Mass mailing --------------------------------------------------------------
# Messages per second: one send, then a 1/RPS pause.
BROADCAST_RPS=20
ANNOUNCE_RPS=20
# Retries of a single message after Telegram answers 429 Too Many Requests.
MAX_RETRIES=5

# --- Google Sheets (optional) -------------------------------------------------
SHEETS_SYNC_ENABLED=false
# GOOGLE_CREDENTIALS_PATH=/etc/tg-bot-giveaway-and-broadcast/service_account.json
# SPREADSHEET_ID=your_spreadsheet_id

# --- Runtime -------------------------------------------------------------------
# SQLite database lives here (bot.db).
DATA_DIR=./data
# ERROR, WARN, INFO, DEBUG or a tracing filter such as "info,sqlx=warn".
LOG_LEVEL=INFO
